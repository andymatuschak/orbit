{
  "private": true,
  "scripts": {
    "build": "tsc -b packages/tsconfig.json",
    "watch": "tsc -b -w packages/tsconfig.json",
    "test:unit": "bun --filter \"!@withorbit/backend\" test",
    "test": "bun run test:unit; bun run --cwd packages/backend test",
    "lint": "cd packages; eslint .",
    "lint:fix": "cd packages; eslint --fix .",
    "checkall": "bun run lint && bun run build && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "better-sqlite3",
    "core-js",
    "esbuild",
    "protobufjs",
    "remark-wiki-link",
    "sqlite3"
  ],
  "workspaces": [
    "packages/*"
  ],
  "name": "@withorbit/umbrella"
}
