{
  "private": true,
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -b packages/tsconfig.json",
    "watch": "node node_modules/@typescript/native/bin/tsc -b -w packages/tsconfig.json",
    "test:unit": "bun --filter '*' --sequential test",
    "test": "bun run test:unit && bun run test:integration",
    "test:integration": "cd packages/automerge-sync-server && bun run test:integration",
    "lint": "cd packages; eslint .",
    "lint:fix": "cd packages; eslint --fix .",
    "checkall": "bun run lint && bun run build && bun run test",
    "lab:checkpoint": "bun packages/app/scripts/lab_checkpoint.ts",
    "lab:server": "node packages/automerge-sync-server/dist/index.js",
    "lab:dev": "bash packages/app/scripts/lab_dev.sh",
    "lab:install": "bash packages/app/scripts/lab_install.sh",
    "lab:seed": "bun packages/automerge-sync-server/scripts/labSeed.ts seed",
    "lab:export": "bun packages/automerge-sync-server/scripts/labSeed.ts export",
    "lab:snapshot": "bun packages/automerge-sync-server/scripts/labSnapshot.ts snapshot",
    "lab:restore": "bun packages/automerge-sync-server/scripts/labSnapshot.ts restore",
    "smoke:web": "bun packages/app/scripts/lab_web_smoke.mjs"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/bun": "1.4.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@expo/metro-runtime": "57.0.15",
    "@grpc/grpc-js": "1.14.5",
    "brace-expansion": "2.1.6",
    "cross-spawn": "7.0.6",
    "expo": "57.0.23",
    "expo-constants": "57.0.17",
    "expo-dev-client": "57.0.18",
    "expo-file-system": "57.0.6",
    "expo-font": "57.0.3",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "glob": "10.5.0",
    "jws": "4.0.1",
    "react-native": "0.86.3",
    "websocket-driver": "0.7.5",
    "expo-updates": "57.0.22"
  },
  "trustedDependencies": [
    "core-js",
    "esbuild",
    "remark-wiki-link"
  ],
  "workspaces": [
    "packages/*"
  ],
  "name": "@withorbit/umbrella"
}
