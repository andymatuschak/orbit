# Keep this aligned with the repository's .gitignore. EAS uses this file instead
# of all .gitignore files when preparing its isolated build directory.
tsconfig.tsbuildinfo
.DS_Store
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage
*.lcov
.nyc_output
.grunt
bower_components
.lock-wscript
build/Release
node_modules
jspm_packages
typings
*.tsbuildinfo
.npm
.eslintcache
.rpt2_cache
.rts2_cache_cjs
.rts2_cache_es
.rts2_cache_umd
.node_repl_history
*.tgz
.yarn-integrity
.env
.env.test
.cache
.next
.nuxt
dist
.vuepress/dist
.serverless
.fusebox
.dynamodb
.tern-port

# Rules from package-specific .gitignore files.
.idea/workspace.xml
packages/api-client/.firebase
packages/app/.expo
packages/app/web-build
packages/app/public/fonts
packages/app/.firebase
packages/app/ios
packages/app/android
packages/app/expo-env.d.ts
packages/backend/.runtimeconfig.json
packages/docs/.firebase
packages/web-component/.firebase
packages/web-component/build

# Proprietary fonts stay out of Git. The local native build does need the OTF
# files in its temporary source archive; web-only font files remain excluded.
packages/app/assets/fonts/dr*
packages/app/assets/fonts/Raptor*
!packages/app/assets/fonts/dr*.otf
