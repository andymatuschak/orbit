{
  "name": "@withorbit/backend",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "rm -rf \"$TMPDIR/orbit-file-storage-emulator\"; firebase emulators:start --import emulator-data",
    "seed:simulator": "bun scripts/seedSimulator.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "build": "tsc -b",
    "predeploy": "bun run build && bun scripts/predeploy.js",
    "deploy": "firebase deploy --only functions",
    "postdeploy": "bun scripts/postdeploy.js",
    "deployCORS": "gsutil cors set ../backend/firebase-storage-cors.json gs://metabook-system.appspot.com",
    "deployFirestoreConfig": "firebase deploy --only firestore",
    "fetchFirestoreIndexes": "firebase firestore:indexes > ../backend/firestore.indexes.json",
    "test:seed:simulator": "bun run typecheck:scripts && bun test scripts/seedSimulator.test.ts",
    "test": "bun run typecheck:scripts && firebase emulators:exec 'bun test src scripts/seedSimulator.test.ts'"
  },
  "license": "AGPL-3.0-or-later OR BUSL-1.1",
  "dependencies": {
    "@withorbit/api": "0.0.1",
    "@withorbit/core": "0.0.1",
    "@withorbit/store-shared": "0.0.1",
    "@withorbit/sample-data": "0.0.1",
    "@google-cloud/bigquery": "^7.3.0",
    "@google-cloud/pubsub": "^4.0.7",
    "ajv": "^8.6.2",
    "busboy": "^0.3.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "date-fns": "^2.16.1",
    "detect-browser": "^5.2.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "isbot-fast": "^1.2.0",
    "morgan-body": "^2.6.6",
    "node-mailjet": "^3.3.1",
    "request-ip": "^2.1.3"
  },
  "engines": {
    "node": "20"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/busboy": "^0.2.3",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.8",
    "@types/date-fns": "^2.6.0",
    "@types/detect-browser": "^4.0.0",
    "@types/node": "24.10.1",
    "@types/node-mailjet": "^3.3.4",
    "@types/request-ip": "^0.0.35",
    "firebase-tools": "^13.29.1",
    "isolate-package": "^1.6.2",
    "typescript": "6.0.3"
  }
}
