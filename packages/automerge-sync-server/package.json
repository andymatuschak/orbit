{
  "name": "@withorbit/automerge-sync-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "deploy",
    "Dockerfile"
  ],
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -b",
    "migrate-account": "node dist/migrateAccount.js",
    "start": "node dist/index.js",
    "enroll-reminders": "node dist/index.js --enroll-reminders",
    "test": "bun test src",
    "test:integration": "bun run build && node --experimental-transform-types --test tests/*.test.mjs",
    "test:durability-convergence": "bun run build && node --experimental-transform-types --test --test-name-pattern='native header admission exchanges|Repo sync survives volume restore|durability and convergence|per-task vault imports|only its persisted sync state' tests/server.integration.test.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "3.4.1",
    "@automerge/automerge-repo": "2.6.0-alpha.5",
    "@automerge/automerge-repo-network-websocket": "2.6.0-alpha.5",
    "@withorbit/api": "0.0.1",
    "@withorbit/core": "0.0.1",
    "@withorbit/store-automerge": "0.0.1",
    "@withorbit/store-shared": "0.0.1",
    "firebase-admin": "14.4.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
