    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
