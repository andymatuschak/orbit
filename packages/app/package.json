{
  "name": "@withorbit/app",
  "version": "1.0.0",
  "main": "./src/index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:review-smoke": "scripts/run_ios_review_smoke.sh",
    "ios:hosted-fetch-smoke": "scripts/run_ios_hosted_fetch_smoke.sh",
    "ios:widget-layout-smoke": "scripts/run_widget_layout_smoke.sh",
    "ios:widget-link-smoke": "scripts/run_widget_link_smoke.sh",
    "ios:release": "expo run:ios --scheme Orbit --configuration Release --no-bundler",
    "deploy:ios:adhoc": "scripts/deploy_ios_adhoc.sh",
    "deploy:ios:testflight": "scripts/deploy_ios_testflight.sh",
    "deploy:ios:testflight:dogfood": "scripts/deploy_ios_testflight.sh dogfood",
    "eas-build-post-install": "bun run --cwd ../.. build && bun scripts/syncIosExtensionBuildNumber.ts",
    "web": "expo start --web -p 19006",
    "smoke:web": "bun scripts/webSmoke.ts",
    "smoke:web:review-links": "bun scripts/webSmoke.ts --access-code",
    "smoke:web:review-links:exported": "bun scripts/webSmoke.ts --exported-access-code",
    "smoke:web:hosted": "bun scripts/webSmoke.ts --hosted",
    "android": "expo run:android",
    "analyze:web": "source-map-explorer 'web-build/_expo/static/js/web/*.js' 'web-build/_expo/static/js/web/*.js.map'",
    "build:web": "expo export -p web --output-dir web-build --source-maps --clear",
    "deploy:web": "scripts/deploy_web.sh",
    "generateBrowserCompatibility": "scripts/generate_browser_compatibility_regex.sh",
    "test": "bun test src expoPlugin",
    "test:widget-projection-reader": "scripts/test_widget_projection_reader.sh",
    "test:widget-projection-writer": "scripts/test_widget_projection_writer.sh",
    "test:widget-projection-handoff": "scripts/test_widget_projection_handoff.sh",
    "storybook": "BABEL_ENV=storybook storybook dev -p 6006",
    "storybook:build": "BABEL_ENV=storybook storybook build"
  },
  "dependencies": {
    "@automerge/automerge-repo": "2.6.0-alpha.5",
    "@bacons/xcode": "1.0.0-alpha.32",
    "@bacons/apple-targets": "5.0.0",
    "@op-engineering/op-sqlite": "18.1.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@withorbit/api": "0.0.1",
    "@withorbit/api-client": "0.0.1",
    "@withorbit/core": "0.0.1",
    "@withorbit/embedded-support": "0.0.1",
    "@withorbit/ingester": "0.0.1",
    "@withorbit/store-fs": "0.0.1",
    "@withorbit/store-automerge": "0.0.1",
    "@withorbit/store-shared": "0.0.1",
    "@withorbit/store-web": "0.0.1",
    "@withorbit/sync": "0.0.1",
    "base-64": "^1.0.0",
    "expo": "57.0.23",
    "expo-application": "~57.0.2",
    "expo-blob": "~57.0.1",
    "expo-constants": "57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "57.0.3",
    "expo-file-system": "57.0.6",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "firebase": "12.18.0",
    "isemail": "^3.2.0",
    "katex": "0.16.10",
    "lodash.isequal": "^4.5.0",
    "markdown-it": "14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mathjax-svg": "andymatuschak/react-native-mathjax-svg",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@expo/metro-runtime": "57.0.15",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-webpack5-compiler-babel": "4.0.1",
    "@storybook/react-webpack5": "10.6.0",
    "@types/base-64": "1.0.2",
    "@types/bun": "1.4.0",
    "@types/katex": "0.16.7",
    "@types/lodash.isequal": "^4.5.5",
    "@types/markdown-it": "14.1.2",
    "@types/react": "~19.2.2",
    "@types/seedrandom": "^2.4.28",
    "@types/webpack": "^4.41.25",
    "@withorbit/sample-data": "0.0.1",
    "babel-loader": "^8.2.2",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "expo-dev-client": "57.0.18",
    "seedrandom": "^3.0.5",
    "source-map-explorer": "2.5.3",
    "storybook": "10.6.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
