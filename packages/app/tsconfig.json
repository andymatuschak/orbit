{
  "extends": ["../tsconfig.base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "module": "commonjs",
    "jsx": "react-native",
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "./src/**/*.tsx",
    "./src/**/*.ts",
    "./scripts/*.ts",
    "./App.tsx",
    "./serviceConfig.ts",
    "../@types/**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "./scripts/ios_hosted_fetch_smoke_server.ts",
    "./scripts/seed_ios_hosted_fetch_smoke.ts"
  ],
  "references": [
    {
      "path": "../api"
    },
    {
      "path": "../api-client"
    },
    {
      "path": "../core"
    },
    {
      "path": "../embedded-support"
    },
    {
      "path": "../sample-data"
    },
    {
      "path": "../store-shared"
    },
    {
      "path": "../store-automerge"
    },
    {
      "path": "../store-fs"
    },
    {
      "path": "../store-web"
    },
    {
      "path": "../ingester"
    },
    {
      "path": "../sync"
    }
  ]
}
