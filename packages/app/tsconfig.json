{
  "extends": [
    "../tsconfig.base.json",
    "expo/tsconfig.base"
  ],
  "compilerOptions": {
    "module": "commonjs",
    "jsx": "react-native",
    "noEmit": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "./src/**/*.tsx",
    "./src/**/*.ts",
    "./scripts/*.ts",
    "./App.tsx",
    "./serviceConfig.ts",
    "../@types/**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "./scripts/ios_hosted_fetch_smoke_server.ts",
    "./scripts/seed_ios_hosted_fetch_smoke.ts",
    "./scripts/lab_checkpoint.ts",
    "./scripts/lab_publish_native.ts"
  ],
  "references": [
    {
      "path": "../api"
    },
    {
      "path": "../core"
    },
    {
      "path": "../sample-data"
    },
    {
      "path": "../store-shared"
    },
    {
      "path": "../store-automerge"
    }
  ]
}
